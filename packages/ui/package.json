{
  "name": "@posthog/ui",
  "version": "1.0.0",
  "description": "React UI layer. Components, stores, hooks. Pure rendering and UI state \u2014 no I/O, no business logic. Built on @posthog/quill. Consumed by every host app (desktop, web, mobile-web).",
  "private": true,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/rimraf.mjs dist .turbo"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.22.1",
    "@pierre/diffs": "^1.1.21",
    "@posthog/api-client": "workspace:*",
    "@posthog/core": "workspace:*",
    "@posthog/di": "workspace:*",
    "@posthog/platform": "workspace:*",
    "@posthog/shared": "workspace:*",
    "@posthog/workspace-client": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.26.2",
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "sonner": "^2.0.7",
    "zustand": "^4.5.0"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "catalog:",
    "@posthog/quill": "catalog:",
    "@radix-ui/themes": "catalog:",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@phosphor-icons/react": "catalog:",
    "@posthog/quill": "catalog:",
    "@posthog/tsconfig": "workspace:*",
    "@radix-ui/themes": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^26.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.10"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ]
}
